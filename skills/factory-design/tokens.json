{
  "$description": "Factory design tokens. Platform-neutral: map to CSS variables, native theme objects, Figma styles, slide themes, or image-generation prompts. Verified against factory.com CSS on 2026-10-25. See tokens.md for provenance.",
  "verified": {
    "date": "2026-10-25",
    "source": "https://factory.com/_next/static/css/*.css (:root block)"
  },
  "source": {
    "--dark-base-primary": "#020202",
    "--dark-base-secondary": "#101010",
    "--light-base-primary": "#eeeeee",
    "--light-base-secondary": "#fafafa",
    "--accent-100": "#ef6f2e",
    "--accent-200": "#ee6018",
    "--accent-300": "#d15010",
    "--surface-page": "#f5f5f5",
    "--surface-raised": "#ffffff",
    "--surface-sunken": "#ebebeb",
    "--docs-grid-line": { "dark": "#b4b3b014", "light": "#0000000f" }
  },
  "dark": {
    "$description": "Product surfaces: apps, CLIs, dashboards, footers, CTA panels, screenshots.",
    "background": "#020202",
    "surface": "#0A0A0A",
    "surfaceRaised": "#101010",
    "border": { "rgba": "rgba(255,255,255,0.09)", "hexOnBackground": "#191919" },
    "borderStrong": { "rgba": "rgba(255,255,255,0.18)", "hexOnBackground": "#303030" },
    "textPrimary": "#EEEEEE",
    "textSecondary": "#8C8C8C",
    "textTertiary": { "rgba": "rgba(255,255,255,0.32)", "hexOnBackground": "#535353" },
    "accent": "#EE6018",
    "accentBright": "#EF6F2E",
    "accentDeep": "#D15010",
    "danger": "#EF4444",
    "primaryButton": { "fill": "#EEEEEE", "label": "#020202" }
  },
  "light": {
    "$description": "Marketing chrome: landing pages, docs, print, light-mode documents.",
    "background": "#F5F5F5",
    "surfaceRaised": "#FFFFFF",
    "surfaceSunken": "#EBEBEB",
    "surfaceAlt": "#FAFAFA",
    "border": { "rgba": "rgba(0,0,0,0.06)", "note": "matches --docs-grid-line" },
    "textPrimary": "#020202",
    "accent": "#EE6018",
    "accentBright": "#EF6F2E",
    "accentDeep": "#D15010",
    "primaryButton": { "fill": "#020202", "label": "#EEEEEE" }
  },
  "typography": {
    "body": "Geist",
    "mono": "Geist Mono",
    "display": "Geist Pixel Square (hero text only)",
    "fallbacks": {
      "body": "system-ui, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "chrome": {
      "case": "uppercase",
      "family": "mono",
      "trackingPx": [0.5, 1.6],
      "eyebrowSizePx": 10,
      "eyebrowWeight": 600
    }
  },
  "radius": {
    "default": "3px",
    "range": ["2px", "6px"],
    "scale": {
      "xs": "0.125rem",
      "sm": "0.1875rem",
      "md": "0.25rem",
      "lg": "0.375rem",
      "xl": "0.5rem",
      "2xl": "0.625rem",
      "3xl": "0.75rem"
    }
  },
  "borderWidth": "1px",
  "motion": {
    "durationMs": [120, 180],
    "siteDefault": "150ms",
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
    "forbid": ["spring", "bounce", "shimmer"]
  },
  "forbidden": ["gradients", "glows", "blur halos", "drop shadows for depth", "pill radii", "purple or indigo accents"]
}
